# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to GitHub.

TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=your_chat_id_here
# Cosmetic status value; the scheduler runs on its five-minute cron.
SCAN_INTERVAL_MINUTES=5
VENUE_MAX_SIGNALS_PER_SCAN=3

# Safe deployment. Only an explicit future switch to live can enable orders.
DEPLOYMENT_MODE=shadow
REGIME_FILTER_MODE=paper
AUTOTRADE_ENABLED=0
LIVE_HIST_EPOCH_TS=1789516800

# Autotrading: Fernet key for encrypting user OKX API keys at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTOTRADE_ENC_KEY=
# Optional overrides
# AUTOTRADE_ENABLED=1
# AUTOTRADE_LEVERAGE=10
# AUTOTRADE_BALANCE_THRESHOLD=100
# AUTOTRADE_CONTACT=@sanja_tusagang
# OKX_TRADE_BASE_URL=https://my.okx.com
